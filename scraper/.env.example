GEMINI_API_KEY=
# 選填,預設 gemini-2.5-flash;若有更合適的模型可在此覆寫
GEMINI_MODEL=
# 選填,主模型過載(503)重試用盡後改用的備援模型,預設 gemini-flash-latest
GEMINI_FALLBACK_MODEL=

# Notion 去重紀錄用(見 scraper/src/lib/notionDedupe.js)
NOTION_API_KEY=
NOTION_DEDUPE_DATABASE_ID=

# LINE Push 用(見 scraper/src/line/pushMessage.js)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_HR_USER_ID=
# 選填,全員群組的 groupId(C 開頭),設定後每日推播會同時發到群組
LINE_STAFF_GROUP_ID=
